# ===== ECR Choco BD - copy to .env and fill in =====

# Host port for the website (nginx). Use 80 in production behind your domain/SSL proxy.
WEB_PORT=80

# --- Core ---
NODE_ENV=production
PORT=5000
# Public URL(s) of the website, no trailing slash. Comma-separate to allow more origins.
CLIENT_URL=http://localhost
# Public base URL payment gateways call back to (usually the same as CLIENT_URL)
API_PUBLIC_URL=http://localhost

# --- MongoDB Atlas ---
# Atlas > Connect > Drivers. Add your server IP to Atlas Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ecr-choco-bd?retryWrites=true&w=majority

# --- Auth (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# --- First admin account (created automatically if no admin exists) ---
ADMIN_NAME=ECR Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123

# --- Cloudinary (https://console.cloudinary.com) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SSLCommerz (optional; leave blank to hide online payment) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# --- bKash Tokenized Checkout (optional; leave blank to hide) ---
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_LIVE=false

# --- Meta (optional). Pixel ID can also be set in Admin > Settings ---
META_PIXEL_ID=
META_CAPI_TOKEN=
